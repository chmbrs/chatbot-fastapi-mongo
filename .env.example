# Copy this file to .env and fill in LLM_API_KEY to talk to a real model.
# Every other variable already has a working default — see README.md for why.
# Nothing here is required to run `docker compose up`.

# --- MongoDB -----------------------------------------------------------
MONGO_URI=mongodb://mongo:27017
MONGO_DB=chatbot

# --- LLM provider --------------------------------------------------------
# auto: use OpenRouter if LLM_API_KEY is set, otherwise fall back to the
#       built-in offline demo provider (no key required, clearly labeled).
# openrouter: always use OpenRouter; fails each turn with a named error if
#       no key is configured.
# ollama: use a model running locally via Ollama. No key, no quota, no
#       signup — but you must have Ollama running and the model pulled.
# demo: always use the offline demo provider, even if a key is set.
# `auto` never selects ollama: a local model is opt-in, never a surprise.
LLM_PROVIDER=auto

# Get a free key at https://openrouter.ai/keys (see README for the 20/min,
# 50/day free-tier limits). Leave unset to run in demo mode.
LLM_API_KEY=

LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemma-4-26b-a4b-it:free

# --- Ollama (only used when LLM_PROVIDER=ollama) --------------------------
# host.docker.internal, not localhost: this app runs inside a container and
# Ollama runs on your host. compose.yaml maps that name on Linux too.
# Pull the model first: `ollama pull llama3.2`
# Prefer a non-reasoning instruct model. Reasoning models (qwen3.5,
# deepseek-r1) stream their thinking in a separate field and leave `content`
# empty until it ends, which over this API looks exactly like a hang.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=llama3.2
