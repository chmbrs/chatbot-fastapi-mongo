# Copy this file to .env and fill in LLM_API_KEY to talk to a real model.
# Every other variable already has a working default — see README.md for why.
# Nothing here is required to run `docker compose up`.

# --- MongoDB -----------------------------------------------------------
MONGO_URI=mongodb://mongo:27017
MONGO_DB=chatbot

# --- LLM provider --------------------------------------------------------
# auto: use OpenRouter if LLM_API_KEY is set, otherwise fall back to the
#       built-in offline demo provider (no key required, clearly labeled).
# openrouter: always use OpenRouter; fails each turn with a named error if
#       no key is configured.
# demo: always use the offline demo provider, even if a key is set.
LLM_PROVIDER=auto

# Get a free key at https://openrouter.ai/keys (see README for the 20/min,
# 50/day free-tier limits). Leave unset to run in demo mode.
LLM_API_KEY=

LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemma-4-26b-a4b-it:free
